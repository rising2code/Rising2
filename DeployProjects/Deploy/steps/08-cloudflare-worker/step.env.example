# 08-cloudflare-worker: Cloudflare Worker: the API on <domain>/api/* with its settings + secrets
# Copy to step.env (git-ignored) and fill in. One value per line, comments on their own line.
#
# Do by hand first:
#   - 07-cloudflare-pages done (the worker's route needs <domain> to be on Cloudflare's proxy)
#   - a deploy token with Account > Workers Scripts Edit and Zone > Workers Routes Edit
#   - a second, DNS-only token for the worker itself (Zone > DNS Edit on this zone): CF_DNS_TOKEN
#   - a worker OVH key, made on your OVH site (ca/eu.api.ovh.com/createToken/), rules with your REAL project id typed in place of PROJECT_ID: GET /cloud/project/PROJECT_ID/*, POST /cloud/project/PROJECT_ID/instance, DELETE /cloud/project/PROJECT_ID/instance/*
#   - SHARED_TOKEN: make one (openssl rand -hex 32) and keep it: 10-test-loop needs the same value

# Cloudflare API token with: Account > Workers Scripts Edit, Zone > Workers Routes Edit (to deploy)
# Looks like: ~40 characters of letters, digits, - and _ (no prefix, not the Global API Key)
CF_API_TOKEN=

# Cloudflare account id (03-cloudflare-dns prints it; also dashboard > Account Home > Account ID)
# Looks like: 32 hex characters, e.g. 023e105f4ecef8ad9ca31a8372d0c353
CF_ACCOUNT_ID=

# the site's domain, a zone in your Cloudflare account
# Looks like: a bare domain: rising2.net (no https://, no slash)
DOMAIN=

# the worker's name
# Looks like: lowercase letters, digits and -
WORKER_NAME=rising2-worker

# R2 bucket name
# Looks like: lowercase letters, digits and -
R2_BUCKET=rising2

# token between the worker and the VM / the test loop
# Looks like: 64 hex characters - make one with: openssl rand -hex 32 (same value in 08-cloudflare-worker and 10-test-loop)
SHARED_TOKEN=

# the captcha's secret (06-cloudflare-turnstile prints it)
# Looks like: starts with 0x4AAAAAAA, ~35 characters (06-cloudflare-turnstile prints it)
TURNSTILE_SECRET=

# the worker's own Cloudflare token: Zone > DNS Edit on this zone only
# Looks like: ~40 characters of letters, digits, - and _ (no prefix, not the Global API Key)
CF_DNS_TOKEN=

# the zone id (03-cloudflare-dns prints it)
# Looks like: 32 hex characters, e.g. 023e105f4ecef8ad9ca31a8372d0c353
CF_ZONE_ID=

# the OVH API site the keys were made on
# Looks like: https://eu.api.ovh.com/1.0 (ca.api.ovh.com / api.us.ovhcloud.com if the key was made there)
OVH_ENDPOINT=https://eu.api.ovh.com/1.0

# the worker's OVH key: Application Key
# Looks like: 16 letters/digits, e.g. 7kbG7Bk7S9Nt7ZSV ("Application Key")
OVH_APP_KEY=

# the worker's OVH key: Application Secret
# Looks like: 32 letters/digits ("Application Secret")
OVH_APP_SECRET=

# the worker's OVH key: Consumer Key
# Looks like: 32 letters/digits ("Consumer Key")
OVH_CONSUMER_KEY=

# the OVH Public Cloud project id, created by hand in the OVH panel
# Looks like: 32 hex characters: the project id (OVH panel > Public Cloud > your project: under its name and in the page URL)
OVH_PROJECT=

# the Discord app's public key (for /start /stop /status) (optional)
# Looks like: 64 hex characters (Developer Portal > General Information > Public Key)
DISCORD_PUBLIC_KEY=

# channel webhook for status + monthly cost posts (optional)
# Looks like: https://discord.com/api/webhooks/<17-20 digits>/<~68 characters>
DISCORD_WEBHOOK_URL=

# OVH region(s) the VM may run in, first choice first (the next is tried if one is full)
# Looks like: OVH region code(s), tried in order: DE1,GRA11 or just GRA11 (others: SBG5, WAW1, UK1, BHS5)
OVH_REGION=DE1,GRA11

# VM sizes to try, in order
# Looks like: comma-separated OVH flavor names, e.g. c3-8,b3-16
OVH_FLAVORS=c3-8,b3-16

# the VM's OS image(s), first one found in the region is used (exact OVH names)
# Looks like: text
OVH_IMAGE=Debian 12 - Docker,Debian 12

# the game VM's name (the worker creates and deletes only this name)
# Looks like: lowercase letters, digits and -
VM_NAME=rising2-lazy

# Game.zip the VM downloads (root holds bin/ and data/); empty or none = no game files (test server)
# Looks like: a full URL: https://..., or none
GAME_ZIP_URL=none

# your public SSH key: every VM lets it in for user debian (logs, debugging) (optional)
# Looks like: one public key line: ssh-ed25519 AAAAC3Nza... you@pc (the .pub file, never the private key)
SSH_PUBLIC_KEY=

# one Start per IP / Discord user per this many hours
# Looks like: a number
START_COOLDOWN_HOURS=20

# Discord role id: no cooldown, may /stop (optional)
# Looks like: a Discord id: 17-20 digits (Developer Mode > right click > Copy ID)
DISCORD_ADMIN_ROLE=

# no Start once this month's OVH cost reaches this (EUR)
# Looks like: a number
MAX_COST_CURRENT=15

# no Start once OVH's forecast for the month reaches this (EUR)
# Looks like: a number
MAX_COST_FORECAST=20

# TTL the worker sets on ip.<domain>
# Looks like: a number
DNS_TTL=60

# How long to wait for the provider before giving up (minutes, optional).
# WAIT_MIN=10
