# Copy to deploy.env and fill in. Never commit deploy.env (it's in .gitignore).
# Anything left empty is listed under "Missing settings" in out/report.md.
# Comments must be on their own line (docker --env-file keeps the rest of a line as the value).

# ================= required =================

# A zone already added to your Cloudflare account.
DOMAIN=rising2.net

# Cloudflare API token (dash.cloudflare.com > My Profile > API Tokens > Create Custom Token):
#   Account: Workers Scripts Edit, Workers R2 Storage Edit, Cloudflare Pages Edit, Turnstile Edit
#   Zone (this domain): DNS Edit, Workers Routes Edit, Zone Read
CF_API_TOKEN=
# Optional: taken from the zone if empty.
CF_ACCOUNT_ID=
# Optional: a DNS-Edit-only token for the worker to use (else it gets CF_API_TOKEN).
CF_DNS_TOKEN=

# OVH API keys (https://eu.api.ovh.com/createToken/), rules:
#   GET /auth/currentCredential, GET /cloud/project, GET/POST/DELETE /cloud/project/*
#   and only for OVH_CREATE_PROJECT=yes: GET/POST /order/*
OVH_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
# The Public Cloud project's name (its "description" in OVH).
OVH_PROJECT_NAME=rising2
# yes = order the project if it's missing (free, pay-as-you-go; needs a payment method on the account).
OVH_CREATE_PROJECT=no
OVH_SUBSIDIARY=FR

# The game files the VM downloads (the zip's root holds bin/ and data/).
GAME_ZIP_URL=

# ================= optional: Discord =================

DISCORD_APP_ID=
# Registers /start /status /stop and sets the interactions URL; the app's public key is read with it.
DISCORD_BOT_TOKEN=
# Commands show at once in this server (else global, up to ~1 h).
DISCORD_GUILD_ID=
# Status lines + the monthly cost in a channel.
DISCORD_WEBHOOK_URL=
# Role id: no cooldown, may /stop.
DISCORD_ADMIN_ROLE=
# The Discord buttons on the landing page.
DISCORD_INVITE=

# ================= optional: landing page =================

# The "1.3GB ZIP download" buttons.
DOWNLOAD_URL=

# ================= optional: names and limits (defaults shown) =================

# R2_BUCKET=rising2
# WORKER_NAME=rising2-worker
# PAGES_PROJECT=rising2
# OVH_REGION=GRA11
# OVH_FLAVORS=c3-8,b3-16
# OVH_IMAGE=Debian 12
# VM_NAME=rising2-lazy
# START_COOLDOWN_HOURS=20
# MAX_COST_CURRENT=15
# MAX_COST_FORECAST=20

# ================= the test loop =================

# yes = start one real VM through the worker, wait for "up", stop it, wait until it's deleted.
# Costs a few minutes of VM time.
TEST_VM=no
# TEST_TIMEOUT_MIN=25
