# 04-cloudflare-r2-create: Cloudflare R2: create the bucket + the 1-day ratelimit/ rule
# Copy to step.env (git-ignored) and fill in. One value per line, comments on their own line.
#
# Do by hand first:
#   - R2 enabled on the account (dashboard > R2 > Purchase / enable - the free tier still asks once)
#   - an API token with Account > Workers R2 Storage Edit

# Cloudflare API token with: Account > Workers R2 Storage Edit
# Looks like: ~40 characters of letters, digits, - and _ (no prefix, not the Global API Key)
CF_API_TOKEN=

# Cloudflare account id (03-cloudflare-dns prints it; also dashboard > Account Home > Account ID)
# Looks like: 32 hex characters, e.g. 023e105f4ecef8ad9ca31a8372d0c353
CF_ACCOUNT_ID=

# R2 bucket name
# Looks like: lowercase letters, digits and -
R2_BUCKET=rising2

# How long to wait for the provider before giving up (minutes, optional).
# WAIT_MIN=5
