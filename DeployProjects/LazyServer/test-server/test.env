# The test server's .env (uploaded as server/.env by Deploy step 05a). No secrets here.
# PUBLIC_IP is appended by cloud_init.sh on the VM.
TEST_MESSAGE=The Rising2 VM loop works.
# Players the test server says are online: 0 = empty, so the VM shuts itself down after ~30 min.
# Set e.g. 3 to see "3 players online" on the landing page (the VM then stays up until /stop or 05:00).
TEST_PLAYERS=0
