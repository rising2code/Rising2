# Copy to server.env, fill in, and upload with Deploy step 05b (or ./upload.sh); it lands in R2 as
# server/.env. Never commit server.env.

# The images Deploy step 04b pushes (it prints these two lines with your Docker Hub user).
IMG_GAMESPY=rising2code/rising2-gamespy-mock-server:latest
IMG_DEDICATED=rising2code/rising2-re-dedicated-server:latest

R2_MOTD=Welcome to Rising2
R2_ADMIN_TOKEN=

# Each dedicated server logs in with its own GameSpy account (not a player's).
OFFICIAL_NICK=srv_official
OFFICIAL_PASS=change-me
OFFICIAL_PROFILE=Eiffel_server
OFFICIAL_PORT=29024

FUN_NICK=srv_fun
FUN_PASS=change-me
FUN_PROFILE=Fun_server
FUN_PORT=29025

# PUBLIC_IP is appended by cloud_init.sh on the VM - leave it out here.
