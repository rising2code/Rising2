# 01-ovh-project: OVH: find (or order) the Public Cloud project
# Copy to step.env (git-ignored) and fill in. One value per line, comments on their own line.
#
# Do by hand first:
#   - OVH account with a payment method (only needed to order a project)
#   - an API key at https://eu.api.ovh.com/createToken/ with rights: GET /auth/currentCredential, GET /cloud/project, GET/POST/DELETE /cloud/project/* (+ GET/POST /order/* to order a project)

# the OVH API site the keys were made on
# Looks like: https://eu.api.ovh.com/1.0 (ca.api.ovh.com / api.us.ovhcloud.com if the key was made there)
OVH_ENDPOINT=https://eu.api.ovh.com/1.0

# OVH deploy key: Application Key
# Looks like: 16 letters/digits, e.g. 7kbG7Bk7S9Nt7ZSV ("Application Key")
OVH_APP_KEY=

# OVH deploy key: Application Secret
# Looks like: 32 letters/digits ("Application Secret")
OVH_APP_SECRET=

# OVH deploy key: Consumer Key
# Looks like: 32 letters/digits ("Consumer Key")
OVH_CONSUMER_KEY=

# the project's name (its description in OVH)
# Looks like: text
OVH_PROJECT_NAME=rising2

# yes = order the project if it's missing (the project is free; you pay for what runs in it)
# Looks like: yes or no
OVH_CREATE_PROJECT=no

# your OVH account's country code, for the order (FR, GB, DE, CA, ...) (optional)
# Looks like: text
OVH_SUBSIDIARY=FR

# How long to wait for the provider before giving up (minutes, optional).
# WAIT_MIN=15
