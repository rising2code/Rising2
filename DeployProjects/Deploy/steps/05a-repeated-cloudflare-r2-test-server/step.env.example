# 05a-repeated-cloudflare-r2-test-server: Cloudflare R2: upload the TEST server (hello page + Dozzle logs) as the VM's compose
# Copy to step.env (git-ignored) and fill in. One value per line, comments on their own line.
#
# Do by hand first:
#   - the R2 bucket created by hand: dashboard > R2 > Create bucket (name = R2_BUCKET)
#   - on it, a lifecycle rule: Settings > Object lifecycle rules > prefix ratelimit/, delete after 1 day
#   - to see the logs: SSH_PUBLIC_KEY in step 08, then ssh -L 8080:localhost:8080 root@ip.<domain> and open http://localhost:8080
#   - without the game files: GAME_ZIP_URL=none in step 08

# Cloudflare API token with: Account > Workers R2 Storage Edit
# Looks like: ~40 characters of letters, digits, - and _ (no prefix, not the Global API Key)
CF_API_TOKEN=

# Cloudflare account id (03-cloudflare-dns prints it; also dashboard > Account Home > Account ID)
# Looks like: 32 hex characters, e.g. 023e105f4ecef8ad9ca31a8372d0c353
CF_ACCOUNT_ID=

# R2 bucket name
# Looks like: lowercase letters, digits and -
R2_BUCKET=rising2

# the site's Discord buttons (site/urls.json) (optional)
# Looks like: https://discord.gg/AbCdEf12
DISCORD_INVITE=

# the site's GitHub button (optional)
# Looks like: a full URL: https://...
GITHUB_URL=https://github.com/rising2code/Rising2

# the site's "1.3GB ZIP download" buttons (optional)
# Looks like: a full URL: https://...
DOWNLOAD_URL=

# true = replace site/urls.json + site/s3files.json if already in R2 (false = keep them, e.g. after editing them in R2)
# Looks like: true or false
OVERWRITE_SITE=false

# How long to wait for the provider before giving up (minutes, optional).
# WAIT_MIN=2
