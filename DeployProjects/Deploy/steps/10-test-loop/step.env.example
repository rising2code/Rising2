# 10-test-loop: Test: start a real VM through the worker, then stop it (a few minutes of VM time)
# Copy to step.env (git-ignored) and fill in. One value per line, comments on their own line.
#
# Do by hand first:
#   - every step before this one done
#   - the VM's files in R2 (05) and Game.zip at GAME_ZIP_URL

# the site's domain, a zone in your Cloudflare account
# Looks like: a bare domain: rising2.net (no https://, no slash)
DOMAIN=

# the worker's base URL (default https://<domain>/api) (optional)
# Looks like: a full URL: https://...
API_URL=

# token between the worker and the VM / the test loop
# Looks like: 64 hex characters - make one with: openssl rand -hex 32 (same value in 08-cloudflare-worker and 10-test-loop)
SHARED_TOKEN=

# the OVH API site the keys were made on
# Looks like: https://eu.api.ovh.com/1.0 (ca.api.ovh.com / api.us.ovhcloud.com if the key was made there)
OVH_ENDPOINT=https://eu.api.ovh.com/1.0

# an OVH key that can list + delete the project's VMs: Application Key
# Looks like: 16 letters/digits, e.g. 7kbG7Bk7S9Nt7ZSV ("Application Key")
OVH_APP_KEY=

# that key's Application Secret
# Looks like: 32 letters/digits ("Application Secret")
OVH_APP_SECRET=

# that key's Consumer Key
# Looks like: 32 letters/digits ("Consumer Key")
OVH_CONSUMER_KEY=

# the OVH Public Cloud project id (01-ovh-project prints it)
# Looks like: 32 hex characters: the project id (01-ovh-project prints it; also in the panel URL)
OVH_PROJECT=

# the game VM's name (the worker creates and deletes only this name)
# Looks like: lowercase letters, digits and -
VM_NAME=rising2-lazy

# how often to check (seconds) (optional)
# Looks like: a number
POLL_SEC=15

# How long to wait for the provider before giving up (minutes, optional).
# WAIT_MIN=25
