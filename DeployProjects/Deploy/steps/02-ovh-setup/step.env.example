# 02-ovh-setup: OVH: enable the region(s), check flavors / image / cost API
# Copy to step.env (git-ignored) and fill in. One value per line, comments on their own line.
#
# Do by hand first:
#   - the Public Cloud project created in the OVH panel (Public Cloud > Create a project); its id goes in OVH_PROJECT
#   - an OVH key with GET /auth/currentCredential and GET/POST/DELETE /cloud/project/* (POST enables a region)

# the OVH API site the keys were made on
# Looks like: https://eu.api.ovh.com/1.0 (ca.api.ovh.com / api.us.ovhcloud.com if the key was made there)
OVH_ENDPOINT=https://eu.api.ovh.com/1.0

# OVH deploy key: Application Key
# Looks like: 16 letters/digits, e.g. 7kbG7Bk7S9Nt7ZSV ("Application Key")
OVH_APP_KEY=

# OVH deploy key: Application Secret
# Looks like: 32 letters/digits ("Application Secret")
OVH_APP_SECRET=

# OVH deploy key: Consumer Key
# Looks like: 32 letters/digits ("Consumer Key")
OVH_CONSUMER_KEY=

# the OVH Public Cloud project id, created by hand in the OVH panel
# Looks like: 32 hex characters: the project id (OVH panel > Public Cloud > your project: under its name and in the page URL)
OVH_PROJECT=

# OVH region(s) the VM may run in, first choice first (the next is tried if one is full)
# Looks like: OVH region code(s), tried in order: DE1,GRA11 or just GRA11 (others: SBG5, WAW1, UK1, BHS5)
OVH_REGION=DE1,GRA11

# VM sizes the worker tries, in order
# Looks like: comma-separated OVH flavor names, e.g. c3-8,b3-16
OVH_FLAVORS=c3-8,b3-16

# the VM's OS image(s), first one found in the region is used (exact OVH names)
# Looks like: text
OVH_IMAGE=Debian 12 - Docker,Debian 12

# the game VM's name (the worker creates and deletes only this name)
# Looks like: lowercase letters, digits and -
VM_NAME=rising2-lazy

# How long to wait for the provider before giving up (minutes, optional).
# WAIT_MIN=10
