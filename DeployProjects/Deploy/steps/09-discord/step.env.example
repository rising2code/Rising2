# 09-discord: Discord: slash commands + interactions URL
# Copy to step.env (git-ignored) and fill in. One value per line, comments on their own line.
#
# Do by hand first:
#   - a Discord application with a bot (discord.com/developers/applications)
#   - the bot invited to your server with the applications.commands scope
#   - 08-repeated-cloudflare-worker deployed WITH DISCORD_PUBLIC_KEY (Discord checks the URL with a signed request)

# Application ID (General Information)
# Looks like: a Discord id: 17-20 digits (Developer Mode > right click > Copy ID)
DISCORD_APP_ID=

# the bot's token (Bot > Reset Token, shown once)
# Looks like: three dot-separated parts, ~70 characters, e.g. MTIz....GaBcDe.xyz... (Bot > Reset Token)
DISCORD_BOT_TOKEN=

# your server's id: commands show there at once (else global, up to ~1 h) (optional)
# Looks like: a Discord id: 17-20 digits (Developer Mode > right click > Copy ID)
DISCORD_GUILD_ID=

# the site's domain, a zone in your Cloudflare account
# Looks like: a bare domain: rising2.net (no https://, no slash)
DOMAIN=

# the channel webhook the worker posts to (only checked here) (optional)
# Looks like: https://discord.com/api/webhooks/<17-20 digits>/<~68 characters>
DISCORD_WEBHOOK_URL=

# How long to wait for the provider before giving up (minutes, optional).
# WAIT_MIN=2
