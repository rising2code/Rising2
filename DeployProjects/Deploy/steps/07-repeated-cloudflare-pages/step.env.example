# 07-repeated-cloudflare-pages: Cloudflare Pages: the landing page on <domain> and www
# Copy to step.env (git-ignored) and fill in. One value per line, comments on their own line.
#
# Do by hand first:
#   - an API token with Account > Cloudflare Pages Edit and Zone > DNS Edit + Zone Read
#   - 06-cloudflare-turnstile done (it prints TURNSTILE_SITEKEY)

# Cloudflare API token with: Account > Cloudflare Pages Edit, Zone > DNS Edit + Zone Read
# Looks like: ~40 characters of letters, digits, - and _ (no prefix, not the Global API Key)
CF_API_TOKEN=

# Cloudflare account id (03-cloudflare-dns prints it; also dashboard > Account Home > Account ID)
# Looks like: 32 hex characters, e.g. 023e105f4ecef8ad9ca31a8372d0c353
CF_ACCOUNT_ID=

# the site's domain, a zone in your Cloudflare account
# Looks like: a bare domain: rising2.net (no https://, no slash)
DOMAIN=

# the Pages project name (the site is also at <name>.pages.dev)
# Looks like: lowercase letters, digits and -
PAGES_PROJECT=rising2

# the captcha's site key (06-cloudflare-turnstile prints it)
# Looks like: starts with 0x4AAAAAAA, ~24 characters (06-cloudflare-turnstile prints it)
TURNSTILE_SITEKEY=

# How long to wait for the provider before giving up (minutes, optional).
# WAIT_MIN=15
