# 03-cloudflare-dns: Cloudflare: DNS records for the game (ip.<domain>, *.<domain>)
# Copy to step.env (git-ignored) and fill in. One value per line, comments on their own line.
#
# Do by hand first:
#   - the domain added to Cloudflare (its nameservers moved to Cloudflare, zone Active)
#   - an API token with Zone:DNS Edit and Zone:Zone Read on that zone

# Cloudflare API token with: Zone > DNS Edit + Zone > Zone Read (this zone)
# Looks like: ~40 characters of letters, digits, - and _ (no prefix, not the Global API Key)
CF_API_TOKEN=

# the site's domain, a zone in your Cloudflare account
# Looks like: a bare domain: rising2.net (no https://, no slash)
DOMAIN=

# TTL of ip.<domain> in seconds (60 is the lowest outside Enterprise)
# Looks like: a number
DNS_TTL=60

# How long to wait for the provider before giving up (minutes, optional).
# WAIT_MIN=5
